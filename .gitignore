# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust / Tauri 构建产物（workspace target）
# target-* 覆盖 CARGO_TARGET_DIR 指向的自定义目录（如 target-check/），
# 单纯的 target/ 不匹配它们，会漏进 git status。
target/
target-*/
src-tauri/target/

# npm 包 postinstall 下载的平台二进制
npm/bin/wb-switch-*

# 本地运行时数据
accounts.json
backups/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
npm/platform/*/bin/

# AI 工具本地配置
.codebuddy/
.cursor/
.agents/
.codex/
.grok/
/.workbuddy/

# 内嵌网关二进制（构建产物，由 scripts/build-gateway 生成）
crates/wb-switch-core/embedded/

# 单文件构建产物（不入库，改由 CI/本地构建生成）
dist-single/
_rel/

# CI 工作流：需 workflow scope 才能推送；本仓库暂由本地构建
# 原上游工作流依赖其私有密钥，已备份至 _workflows_backup/
.github/workflows/

# 更新签名私钥（绝不入库；丢失后无法签名新版本）
*.key
*.key.pub
!.gitignore
