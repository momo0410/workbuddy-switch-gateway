{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy Switch Gateway",
  "version": "0.6.0",
  "identifier": "com.momo0410.wbswitch.gateway",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkBuddy Switch Gateway · 账号管理 + 兼容网关",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "WebView2Loader.dll"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxN0MwRTJCNDMyMUQ4NDEKUldSQjJDRkRLdzU4SVY1d2d5azNhcjlKODZOVGJhTDZLK2Z3K3ZTcG5RVmlOZ29UMWNkYk5uQ3AK",
      "endpoints": [
        "https://github.com/momo0410/workbuddy-switch-gateway/releases/latest/download/latest.json",
        "https://github.com/momo0410/workbuddy-switch-gateway/releases/latest/download/latest-{{target}}-{{arch}}.json"
      ]
    }
  }
}
