+//
+// domain 缺失时按国服处理：历史上只存在国服账号，保持向后兼容。
+func isIntl(a *auth.Auth) bool {
+	if a == nil {
+		return false
+	}
+	return strings.HasSuffix(strings.ToLower(strings.TrimSpace(a.Domain)), ".ai")
 }
 
